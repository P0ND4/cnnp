import { Inject, Injectable } from '@nestjs/common';
import { Redis } from 'ioredis';
import type {
  IVerificationCodePort,
  PendingRegistration,
} from '../../domain/ports/verification-code.port';

interface StoredVerification extends PendingRegistration {
  code: string;
}

@Injectable()
export class VerificationCodeService implements IVerificationCodePort {
  private readonly TTL_SECONDS = 15 * 60;
  private readonly KEY_PREFIX = 'verification:';

  constructor(@Inject('REDIS_CLIENT') private readonly redis: Redis) {}

  async store(
    email: string,
    code: string,
    data: PendingRegistration,
  ): Promise<void> {
    const payload: StoredVerification = { code, ...data };
    await this.redis.setex(
      `${this.KEY_PREFIX}${email}`,
      this.TTL_SECONDS,
      JSON.stringify(payload),
    );
  }

  async retrieve(
    email: string,
    code: string,
  ): Promise<PendingRegistration | null> {
    const raw = await this.redis.get(`${this.KEY_PREFIX}${email}`);
    if (!raw) return null;

    const stored = JSON.parse(raw) as StoredVerification;
    if (stored.code !== code) return null;

    return {
      email: stored.email,
      passwordHash: stored.passwordHash,
      fullName: stored.fullName,
    };
  }

  async getPending(email: string): Promise<PendingRegistration | null> {
    const raw = await this.redis.get(`${this.KEY_PREFIX}${email}`);
    if (!raw) return null;

    const stored = JSON.parse(raw) as StoredVerification;
    return {
      email: stored.email,
      passwordHash: stored.passwordHash,
      fullName: stored.fullName,
    };
  }

  async delete(email: string): Promise<void> {
    await this.redis.del(`${this.KEY_PREFIX}${email}`);
  }
}
EOF

