  @Throttle({ default: { limit: 3, ttl: minutes(15) } })
  @ApiOperation({
    summary: 'Resend verification code',
    description:
      'Generates a new code and resends it to the email. Requires a pending registration. Overwrites the previous code.',
  })
  @ApiResponse({
    status: 200,
    description: 'New verification code sent.',
    schema: {
      example: {
        success: true,
        statusCode: 200,
        data: { message: 'New verification code sent to your email' },
