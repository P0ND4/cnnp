import { Inject, Injectable } from '@nestjs/common';
import { randomInt } from 'crypto';
import type { UserEntity } from 'src/contexts/shared/domain/entities/auth/user.entity';
import {
  JWT_EXPIRATION,
  JWT_REFRESH_EXPIRATION,
  REFRESH_BLACKLIST_TTL_SECONDS,
} from 'src/contexts/shared/constants/jwt.constants';
import { UNIT_OF_WORK } from 'src/contexts/shared/domain/repositories/unit-of-work.interface';
import type { IUnitOfWork } from 'src/contexts/shared/domain/repositories/unit-of-work.interface';
import {
  InvalidCredentialsError,
  InvalidOrExpiredCodeError,
  NoPendingRegistrationError,
  SocialAuthFailedError,
  UserAlreadyExistsError,
  UserInactiveError,
} from '../../domain/errors/auth/index';
import { TOKEN_SERVICE } from 'src/contexts/shared/domain/ports/token.port';
import type { ITokenService } from 'src/contexts/shared/domain/ports/token.port';
import { TOKEN_BLACKLIST_PORT } from 'src/contexts/shared/domain/ports/token-blacklist.port';
import type { ITokenBlacklistPort } from 'src/contexts/shared/domain/ports/token-blacklist.port';
import { MAIL_PORT } from '../../domain/ports/mail.port';
import type { IMailPort } from '../../domain/ports/mail.port';
import { PASSWORD_PORT } from '../../domain/ports/password.port';
import type { IPasswordPort } from '../../domain/ports/password.port';
import { VERIFICATION_CODE_PORT } from '../../domain/ports/verification-code.port';
import type { IVerificationCodePort } from '../../domain/ports/verification-code.port';
import {
  GOOGLE_AUTH_PORT,
  APPLE_AUTH_PORT,
} from '../../domain/ports/social-auth.port';
import type {
  IGoogleAuthPort,
  IAppleAuthPort,
} from '../../domain/ports/social-auth.port';
import type { IAuthUseCase } from '../../domain/contracts/i-auth.use-case';
import {
  AuthResponseDto,
  UserResponseDto,
} from '../../domain/dtos/auth-response.dto';
import { LoginDto } from '../../domain/dtos/login.dto';
import { RegisterDto } from '../../domain/dtos/register.dto';
import { ResendCodeDto } from '../../domain/dtos/resend-code.dto';
import { VerifyEmailDto } from '../../domain/dtos/verify-email.dto';

@Injectable()
export class AuthUseCase implements IAuthUseCase {
  constructor(
    @Inject(UNIT_OF_WORK)
    private readonly uow: IUnitOfWork,
    @Inject(PASSWORD_PORT)
    private readonly passwordPort: IPasswordPort,
    @Inject(VERIFICATION_CODE_PORT)
    private readonly verificationCodePort: IVerificationCodePort,
    @Inject(MAIL_PORT)
    private readonly mailPort: IMailPort,
    @Inject(TOKEN_BLACKLIST_PORT)
    private readonly tokenBlacklistPort: ITokenBlacklistPort,
    @Inject(GOOGLE_AUTH_PORT)
    private readonly googleAuthPort: IGoogleAuthPort,
    @Inject(APPLE_AUTH_PORT)
    private readonly appleAuthPort: IAppleAuthPort,
    @Inject(TOKEN_SERVICE)
    private readonly tokenService: ITokenService,
  ) {}

  async register(dto: RegisterDto): Promise<{ message: string }> {
    const existing = await this.uow.users.findByEmail(dto.email);
    if (existing) throw new UserAlreadyExistsError();

    const passwordHash = await this.passwordPort.hash(dto.password);
    const code = this.generateCode();
    await this.verificationCodePort.store(dto.email, code, {
      email: dto.email,
      passwordHash,
      fullName: dto.fullName,
    });
    await this.mailPort.sendVerificationCode(dto.email, dto.fullName, code);
    return { message: 'Verification code sent to your email' };
  }

  async verifyEmail(dto: VerifyEmailDto): Promise<AuthResponseDto> {
    const existing = await this.uow.users.findByEmail(dto.email);
    if (existing) throw new UserAlreadyExistsError();

    const pending = await this.verificationCodePort.retrieve(
      dto.email,
      dto.code,
    );
    if (!pending) throw new InvalidOrExpiredCodeError();

    const user = await this.uow.users.create({
      email: pending.email,
      name: pending.fullName,
      passwordHash: pending.passwordHash,
      isActive: true,
      emailVerifiedAt: new Date(),
    });
    await this.verificationCodePort.delete(dto.email);
    return this.buildAuthResponse(user);
  }

  async resendCode(dto: ResendCodeDto): Promise<{ message: string }> {
    const existing = await this.uow.users.findByEmail(dto.email);
    if (existing) throw new UserAlreadyExistsError();

    const pending = await this.verificationCodePort.getPending(dto.email);
    if (!pending) throw new NoPendingRegistrationError();

    const code = this.generateCode();
    await this.verificationCodePort.store(dto.email, code, pending);
    await this.mailPort.sendVerificationCode(dto.email, pending.fullName, code);
    return { message: 'New verification code sent to your email' };
  }

  async login(dto: LoginDto): Promise<AuthResponseDto> {
    const user = await this.uow.users.findByEmail(dto.email);
    if (!user || !user.passwordHash) throw new InvalidCredentialsError();
    if (!user.isActive) throw new UserInactiveError();

    const valid = await this.passwordPort.compare(
      dto.password,
      user.passwordHash,
    );
    if (!valid) throw new InvalidCredentialsError();

    return this.buildAuthResponse(user);
  }

  async refresh(refreshToken: string): Promise<AuthResponseDto> {
    let payload: { sub: string; email: string };
    try {
      payload = await this.tokenService.verify<{ sub: string; email: string }>(
        refreshToken,
      );
    } catch {
      throw new InvalidCredentialsError();
    }

    const blacklisted =
      await this.tokenBlacklistPort.isBlacklisted(refreshToken);
    if (blacklisted) throw new InvalidCredentialsError();

    const user = await this.uow.users.findById(payload.sub);
    if (!user) throw new InvalidCredentialsError();

    await this.tokenBlacklistPort.add(
      refreshToken,
      REFRESH_BLACKLIST_TTL_SECONDS,
    );
    return this.buildAuthResponse(user);
  }

  async logout(
    accessToken: string,
    refreshToken?: string,
  ): Promise<{ message: string }> {
    try {
      const decoded = this.tokenService.decode<{ exp: number }>(accessToken);
      if (decoded?.exp) {
        const ttl = Math.max(decoded.exp - Math.floor(Date.now() / 1000), 1);
        await this.tokenBlacklistPort.add(accessToken, ttl);
      }
    } catch {
      // malformed token — nothing to blacklist
    }

    if (refreshToken) {
      await this.tokenBlacklistPort.add(
        refreshToken,
        REFRESH_BLACKLIST_TTL_SECONDS,
      );
    }
    return { message: 'Logged out successfully' };
  }

  async loginWithGoogle(idToken: string): Promise<AuthResponseDto> {
    let socialData: Awaited<ReturnType<IGoogleAuthPort['verify']>>;
    try {
      socialData = await this.googleAuthPort.verify(idToken);
    } catch {
      throw new SocialAuthFailedError();
    }

    let user = await this.uow.users.findByEmail(socialData.email);
    if (user) {
      if (!user.isActive) throw new UserInactiveError();
      if (!user.googleId) {
        await this.uow.users.update(user.id, {
          googleId: socialData.providerId,
        });
      }
    } else {
      user = await this.uow.users.create({
        email: socialData.email,
        name: socialData.fullName ?? null,
        isActive: true,
        emailVerifiedAt: new Date(),
        googleId: socialData.providerId,
      });
    }
    return this.buildAuthResponse(user);
  }

  async loginWithApple(
    identityToken: string,
    fullName?: string,
  ): Promise<AuthResponseDto> {
    let socialData: Awaited<ReturnType<IAppleAuthPort['verify']>>;
    try {
      socialData = await this.appleAuthPort.verify(identityToken);
    } catch {
      throw new SocialAuthFailedError();
    }

    let user = await this.uow.users.findByEmail(socialData.email);
    if (user) {
      if (!user.isActive) throw new UserInactiveError();
      if (!user.appleId) {
        await this.uow.users.update(user.id, {
          appleId: socialData.providerId,
        });
      }
    } else {
      user = await this.uow.users.create({
        email: socialData.email,
        name: fullName ?? socialData.fullName ?? null,
        isActive: true,
        emailVerifiedAt: new Date(),
        appleId: socialData.providerId,
      });
    }
    return this.buildAuthResponse(user);
  }

  private async buildAuthResponse(user: UserEntity): Promise<AuthResponseDto> {
    const payload = { sub: user.id, email: user.email };
    const [accessToken, refreshToken] = await Promise.all([
      this.tokenService.sign(payload, { expiresIn: JWT_EXPIRATION }),
      this.tokenService.sign(payload, { expiresIn: JWT_REFRESH_EXPIRATION }),
    ]);
    return { accessToken, refreshToken, user: this.toUserResponse(user) };
  }

  private generateCode(digits = 6): string {
    return randomInt(Math.pow(10, digits)).toString().padStart(digits, '0');
  }

  private toUserResponse(user: UserEntity): UserResponseDto {
    return {
      id: user.id,
      email: user.email,
      name: user.name,
      createdAt: user.createdAt,
    };
  }
}
