import {
  BadRequestException,
  ConflictException,
  Inject,
  Injectable,
  UnauthorizedException,
} from '@nestjs/common';
import { JwtService } from '@nestjs/jwt';
import { randomInt, randomUUID } from 'crypto';
import type { UserEntity } from 'src/contexts/shared/domain/entities/auth/user.entity';
import { REFRESH_BLACKLIST_TTL_SECONDS } from 'src/contexts/shared/constants/jwt.constants';
import { UNIT_OF_WORK } from 'src/contexts/shared/domain/repositories/unit-of-work.interface';
import type { IUnitOfWork } from 'src/contexts/shared/domain/repositories/unit-of-work.interface';
import { AUTH_ERRORS } from '../constants/auth-error.constants';
import { AuthResponseDto, UserResponseDto } from '../dtos/auth-response.dto';
import { LoginDto } from '../dtos/login.dto';
import { RegisterDto } from '../dtos/register.dto';
import { ResendCodeDto } from '../dtos/resend-code.dto';
import { VerifyEmailDto } from '../dtos/verify-email.dto';
import { MAIL_PORT } from '../ports/mail.port';
import type { IMailPort } from '../ports/mail.port';
import { PASSWORD_PORT } from '../ports/password.port';
import type { IPasswordPort } from '../ports/password.port';
import { TOKEN_BLACKLIST_PORT } from '../ports/token-blacklist.port';
import type { ITokenBlacklistPort } from '../ports/token-blacklist.port';
import { VERIFICATION_CODE_PORT } from '../ports/verification-code.port';
import type { IVerificationCodePort } from '../ports/verification-code.port';
import { GOOGLE_AUTH_PORT, APPLE_AUTH_PORT } from '../ports/social-auth.port';
import type {
  IGoogleAuthPort,
  IAppleAuthPort,
  SocialUserData,
} from '../ports/social-auth.port';

@Injectable()
export class AuthUseCase {
  constructor(
    @Inject(UNIT_OF_WORK)
    private readonly uow: IUnitOfWork,
    @Inject(PASSWORD_PORT)
    private readonly passwordPort: IPasswordPort,
    @Inject(VERIFICATION_CODE_PORT)
    private readonly verificationCodePort: IVerificationCodePort,
    @Inject(MAIL_PORT)
    private readonly mailPort: IMailPort,
    @Inject(TOKEN_BLACKLIST_PORT)
    private readonly tokenBlacklistPort: ITokenBlacklistPort,
    @Inject(GOOGLE_AUTH_PORT)
    private readonly googleAuthPort: IGoogleAuthPort,
    @Inject(APPLE_AUTH_PORT)
    private readonly appleAuthPort: IAppleAuthPort,
    private readonly jwtService: JwtService,
  ) {}

  async register(dto: RegisterDto): Promise<{ message: string }> {
    const existing = await this.uow.users.findByEmail(dto.email);
    if (existing) throw new ConflictException(AUTH_ERRORS.EMAIL_ALREADY_EXISTS);

    const code = this.generateCode();
    const passwordHash = await this.passwordPort.hash(dto.password);

    await this.verificationCodePort.store(dto.email, code, {
      email: dto.email,
      passwordHash,
      fullName: dto.fullName,
    });

    await this.mailPort.sendVerificationCode(dto.email, dto.fullName, code);

    return { message: 'Verification code sent to your email' };
  }

  async verifyEmail(dto: VerifyEmailDto): Promise<AuthResponseDto> {
    const pending = await this.verificationCodePort.retrieve(
      dto.email,
      dto.code,
    );
    if (!pending)
      throw new BadRequestException(AUTH_ERRORS.INVALID_OR_EXPIRED_CODE);

    const existing = await this.uow.users.findByEmail(dto.email);
    if (existing) throw new ConflictException(AUTH_ERRORS.EMAIL_ALREADY_EXISTS);

    const user = await this.uow.users.create({
      email: pending.email,
      password: pending.passwordHash,
      fullName: pending.fullName,
      emailVerifiedAt: new Date(),
    });

    await this.verificationCodePort.delete(dto.email);

    return this.buildAuthResponse(user);
  }

  async resendCode(dto: ResendCodeDto): Promise<{ message: string }> {
    const existing = await this.uow.users.findByEmail(dto.email);
    if (existing) throw new ConflictException(AUTH_ERRORS.EMAIL_ALREADY_EXISTS);

    const pending = await this.verificationCodePort.getPending(dto.email);
    if (!pending)
      throw new BadRequestException(AUTH_ERRORS.NO_PENDING_REGISTRATION);

    const code = this.generateCode();
    await this.verificationCodePort.store(dto.email, code, pending);
    await this.mailPort.sendVerificationCode(dto.email, pending.fullName, code);

    return { message: 'New verification code sent to your email' };
  }

  async login(dto: LoginDto): Promise<AuthResponseDto> {
    const user = await this.uow.users.findByEmail(dto.email);
    if (!user) throw new UnauthorizedException(AUTH_ERRORS.INVALID_CREDENTIALS);
    if (!user.isActive)
      throw new UnauthorizedException(AUTH_ERRORS.USER_INACTIVE);

    const valid = await this.passwordPort.compare(dto.password, user.password);
    if (!valid)
      throw new UnauthorizedException(AUTH_ERRORS.INVALID_CREDENTIALS);

    return this.buildAuthResponse(user);
  }

  async refresh(refreshToken: string): Promise<AuthResponseDto> {
    let payload: { sub: string; email: string };
    try {
      payload = await this.jwtService.verifyAsync(refreshToken);
    } catch {
      throw new UnauthorizedException(AUTH_ERRORS.INVALID_TOKEN);
    }

    const blacklisted =
      await this.tokenBlacklistPort.isBlacklisted(refreshToken);
    if (blacklisted) throw new UnauthorizedException(AUTH_ERRORS.INVALID_TOKEN);

    const user = await this.uow.users.findById(payload.sub);
    if (!user) throw new UnauthorizedException(AUTH_ERRORS.INVALID_CREDENTIALS);
    if (!user.isActive)
      throw new UnauthorizedException(AUTH_ERRORS.USER_INACTIVE);

    await this.tokenBlacklistPort.add(
      refreshToken,
      REFRESH_BLACKLIST_TTL_SECONDS,
    );

    return this.buildAuthResponse(user);
  }

  async logout(
    accessToken: string,
    refreshToken?: string,
  ): Promise<{ message: string }> {
    try {
      const decoded = this.jwtService.decode<{ exp: number }>(accessToken);
      if (decoded?.exp) {
        const ttl = Math.max(decoded.exp - Math.floor(Date.now() / 1000), 1);
        await this.tokenBlacklistPort.add(accessToken, ttl);
      }
    } catch {
      // malformed token — nothing to blacklist
    }

    if (refreshToken) {
      await this.tokenBlacklistPort.add(
        refreshToken,
        REFRESH_BLACKLIST_TTL_SECONDS,
      );
    }

    return { message: 'Logged out successfully' };
  }

  async loginWithGoogle(idToken: string): Promise<AuthResponseDto> {
    let social: SocialUserData;
    try {
      social = await this.googleAuthPort.verify(idToken);
    } catch {
      throw new UnauthorizedException(AUTH_ERRORS.SOCIAL_AUTH_FAILED);
    }
    return this.loginWithSocial(social, 'google');
  }

  async loginWithApple(
    identityToken: string,
    fullName?: string,
  ): Promise<AuthResponseDto> {
    let social: SocialUserData;
    try {
      social = await this.appleAuthPort.verify(identityToken);
    } catch {
      throw new UnauthorizedException(AUTH_ERRORS.SOCIAL_AUTH_FAILED);
    }
    if (fullName) social = { ...social, fullName };
    return this.loginWithSocial(social, 'apple');
  }

  private async loginWithSocial(
    social: SocialUserData,
    provider: 'google' | 'apple',
  ): Promise<AuthResponseDto> {
    const findByProvider =
      provider === 'google'
        ? (id: string) => this.uow.users.findByGoogleId(id)
        : (id: string) => this.uow.users.findByAppleId(id);

    let user = await findByProvider(social.providerId);

    if (!user) {
      user = await this.uow.users.findByEmail(social.email);

      if (user) {
        const link =
          provider === 'google'
            ? { googleId: social.providerId }
            : { appleId: social.providerId };
        user = (await this.uow.users.update(user.id, link)) ?? user;
      } else {
        const providerField =
          provider === 'google'
            ? { googleId: social.providerId }
            : { appleId: social.providerId };

        user = await this.uow.users.create({
          email: social.email,
          password: randomUUID(),
          fullName: social.fullName ?? social.email.split('@')[0],
          emailVerifiedAt: new Date(),
          ...providerField,
        });
      }
    }

    if (!user.isActive)
      throw new UnauthorizedException(AUTH_ERRORS.USER_INACTIVE);
    return this.buildAuthResponse(user);
  }

  private async buildAuthResponse(user: UserEntity): Promise<AuthResponseDto> {
    const payload = { sub: user.id, email: user.email };
    const [accessToken, refreshToken] = await Promise.all([
      this.jwtService.signAsync(payload, { expiresIn: '15m' }),
      this.jwtService.signAsync(payload, { expiresIn: '7d' }),
    ]);
    return { accessToken, refreshToken, user: this.toUserResponse(user) };
  }

  private generateCode(digits = 6): string {
    return randomInt(Math.pow(10, digits)).toString().padStart(digits, '0');
  }

  private toUserResponse(user: UserEntity): UserResponseDto {
    return {
      id: user.id,
      email: user.email,
      fullName: user.fullName,
      isActive: user.isActive,
      emailVerifiedAt: user.emailVerifiedAt ?? null,
      createdAt: user.createdAt,
    };
  }
}
EOF

