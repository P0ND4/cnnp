import {
  Body,
  Controller,
  Headers,
  HttpCode,
  HttpStatus,
  Post,
} from '@nestjs/common';
import {
  ApiBearerAuth,
  ApiOperation,
  ApiResponse,
  ApiTags,
} from '@nestjs/swagger';
import { Throttle } from '@nestjs/throttler';
import { AuthResponseDto } from '../../../../../application/dtos/auth-response.dto';
import { AuthUseCase } from '../../../../../application/use-cases/auth.use-case';
import { V1_AUTH } from '../../../route.constants';
import { AppleAuthRequest } from '../requests/apple-auth.request';
import { GoogleAuthRequest } from '../requests/google-auth.request';
import { LoginRequest } from '../requests/login.request';
import { LogoutRequest } from '../requests/logout.request';
import { RefreshRequest } from '../requests/refresh.request';
import { RegisterRequest } from '../requests/register.request';
import { ResendCodeRequest } from '../requests/resend-code.request';
import { VerifyEmailRequest } from '../requests/verify-email.request';

const MIN_15 = 15 * 60 * 1000;
const MIN_60 = 60 * 60 * 1000;

@ApiTags('Auth')
@Controller(V1_AUTH)
export class AuthController {
  constructor(private readonly authUseCase: AuthUseCase) {}

  @Post('register')
  @HttpCode(HttpStatus.CREATED)
  @Throttle({ default: { limit: 5, ttl: MIN_60 } })
  @ApiOperation({
    summary: 'Register a new user',
    description:
      'Creates a pending registration and sends a 6-digit verification code to the provided email. The account is only created after the code is verified.',
  })
  @ApiResponse({
    status: 201,
    description: 'Verification code sent successfully.',
    schema: {
      example: {
        success: true,
        statusCode: 201,
        data: { message: 'Verification code sent to your email' },
      },
    },
  })
  @ApiResponse({ status: 409, description: 'Email already registered.' })
  @ApiResponse({
    status: 429,
    description: 'Too many requests. Limit: 5 per hour.',
  })
  register(@Body() req: RegisterRequest) {
    return this.authUseCase.register({
      email: req.email,
      password: req.password,
      fullName: req.fullName,
    });
  }

  @Post('verify-email')
  @HttpCode(HttpStatus.OK)
  @Throttle({ default: { limit: 10, ttl: MIN_15 } })
  @ApiOperation({
    summary: 'Verify email with code',
    description:
      'Validates the 6-digit code sent by email. On success, creates the user account and returns JWT tokens.',
  })
  @ApiResponse({
    status: 200,
    description: 'Email verified. Account created and tokens issued.',
    type: AuthResponseDto,
  })
  @ApiResponse({
    status: 400,
    description: 'Invalid or expired verification code.',
  })
  @ApiResponse({ status: 409, description: 'Email already registered.' })
  @ApiResponse({
    status: 429,
    description: 'Too many requests. Limit: 10 per 15 min.',
  })
  verifyEmail(@Body() req: VerifyEmailRequest) {
    return this.authUseCase.verifyEmail({ email: req.email, code: req.code });
  }

  @Post('resend-code')
  @HttpCode(HttpStatus.OK)
  @Throttle({ default: { limit: 3, ttl: MIN_15 } })
  @ApiOperation({
    summary: 'Resend verification code',
    description:
      'Generates a new code and resends it to the email. Requires a pending registration. Overwrites the previous code.',
  })
  @ApiResponse({
    status: 200,
    description: 'New verification code sent.',
    schema: {
      example: {
        success: true,
        statusCode: 200,
        data: { message: 'New verification code sent to your email' },
      },
    },
  })
  @ApiResponse({ status: 400, description: 'No pending registration found.' })
  @ApiResponse({ status: 409, description: 'Email already registered.' })
  @ApiResponse({
    status: 429,
    description: 'Too many requests. Limit: 3 per 15 min.',
  })
  resendCode(@Body() req: ResendCodeRequest) {
    return this.authUseCase.resendCode({ email: req.email });
  }

  @Post('login')
  @HttpCode(HttpStatus.OK)
  @Throttle({ default: { limit: 10, ttl: MIN_15 } })
  @ApiOperation({
    summary: 'Login with email and password',
    description:
      'Authenticates the user and returns a short-lived access token (15 min) and a long-lived refresh token (7 days).',
  })
  @ApiResponse({
    status: 200,
    description: 'Login successful. Tokens issued.',
    type: AuthResponseDto,
  })
  @ApiResponse({
    status: 401,
    description: 'Invalid credentials or inactive account.',
  })
  @ApiResponse({
    status: 429,
    description: 'Too many requests. Limit: 10 per 15 min.',
  })
  login(@Body() req: LoginRequest) {
    return this.authUseCase.login({ email: req.email, password: req.password });
  }

  @Post('refresh')
  @HttpCode(HttpStatus.OK)
  @Throttle({ default: { limit: 10, ttl: MIN_15 } })
  @ApiOperation({
    summary: 'Refresh access token',
    description:
      'Validates the refresh token, blacklists it, and issues a new access token + refresh token pair (token rotation).',
  })
  @ApiResponse({
    status: 200,
    description: 'New token pair issued.',
    type: AuthResponseDto,
  })
  @ApiResponse({
    status: 401,
    description: 'Invalid, expired, or already used refresh token.',
  })
  @ApiResponse({
    status: 429,
    description: 'Too many requests. Limit: 10 per 15 min.',
  })
  refresh(@Body() req: RefreshRequest) {
    return this.authUseCase.refresh(req.refreshToken);
  }

  @Post('logout')
  @HttpCode(HttpStatus.OK)
  @ApiBearerAuth('access-token')
  @ApiOperation({
    summary: 'Logout',
    description:
      'Blacklists the access token (from Authorization header) and optionally the refresh token (from body). Both tokens become immediately invalid.',
  })
  @ApiResponse({
    status: 200,
    description: 'Logged out successfully.',
