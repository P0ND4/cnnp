  @Post('verify-email')
  @HttpCode(HttpStatus.OK)
  @Throttle({ default: { limit: 10, ttl: minutes(15) } })
  @ApiOperation({
    summary: 'Verify email with code',
    description:
      'Validates the 6-digit code sent by email. On success, creates the user account and returns JWT tokens.',
  })
  @ApiResponse({
    status: 200,
    description: 'Email verified. Account created and tokens issued.',
    type: AuthResponseResponse,
  })
  @ApiResponse({
    status: 400,
    description: 'Invalid or expired verification code.',
  })
  @ApiResponse({ status: 409, description: 'Email already registered.' })
  @ApiResponse({
    status: 429,
    description: 'Too many requests. Limit: 10 per 15 min.',
