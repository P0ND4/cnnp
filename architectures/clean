@Public()
@ApiTags('Auth')
@Controller(V1_AUTH)
export class AuthController {
  constructor(
    @Inject(AUTH_USE_CASE) private readonly authUseCase: IAuthUseCase,
  ) {}

  @Post('register')
  @HttpCode(HttpStatus.CREATED)
  @Throttle({ default: { limit: 5, ttl: minutes(60) } })
  @ApiOperation({
    summary: 'Register a new user',
    description:
      'Creates a pending registration and sends a 6-digit verification code to the provided email. The account is only created after the code is verified.',
  })
  @ApiResponse({
    status: 201,
    description: 'Verification code sent successfully.',
    schema: {
      example: {
        success: true,
        statusCode: 201,
        data: { message: 'Verification code sent to your email' },
      },
    },
  })
  @ApiResponse({ status: 409, description: 'Email already registered.' })
  @ApiResponse({
    status: 429,
    description: 'Too many requests. Limit: 5 per hour.',
  })
  register(@Body() req: RegisterRequest) {
    return this.authUseCase.register({
      email: req.email,
      password: req.password,
      fullName: req.fullName,
    });
