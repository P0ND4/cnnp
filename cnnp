#!/usr/bin/env bash

set -euo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
NC=$'\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

print_error()   { echo -e "${RED}[x] $1${NC}"; }
print_success() { echo -e "${GREEN}[✓] $1${NC}"; }
print_info()    { echo -e "${BLUE}[-] $1${NC}"; }
print_warning() { echo -e "${YELLOW}[⚠] $1${NC}"; }
print_step()    { echo -e "\n${BLUE}[▸] $1${NC}"; }

show_help() {
cat << EOF
    ${GREEN}Create New Nest Project${NC}

    ${YELLOW}Usage:${NC}
    cnnp --pn PROJECT_NAME --pk PACKAGE_MANAGER --a ARCHITECTURE

    ${YELLOW}Options:${NC}
    --pn, --project-name     Project name (required)
    --pk, --package          Package manager: pnpm | npm | yarn (required)
    --a, --architecture      Architecture: clean (required)
    --dir, --directory       Custom directory (optional, defaults to current dir)
    --skip-install           Skip dependencies installation (optional)
    --help                   Show this help message

    ${YELLOW}Architecture Types:${NC}
    ${GREEN}clean${NC}      - Simple structure, all in modules

    ${YELLOW}Examples:${NC}
    cnnp --pn auth-api --pk pnpm --a clean
    cnnp --project-name users-api --package npm --architecture clean --directory ./backend --skip-install
    cnnp --pn payment-api --pk yarn --a clean --dir ./projects
EOF
}

PROJECT_NAME=""
PACKAGE_MANAGER=""
ARCHITECTURE=""
DIRECTORY=""
SKIP_INSTALL=false
SKIP_GIT=false

check_dependencies() {
    local missing=()

    if ! command -v node &> /dev/null; then
        print_error "Node.js is not installed. Please install it from https://nodejs.org/ or using NVM (Node Version Manager)."
        exit 1
    fi

    if ! command -v nest &> /dev/null; then
        missing+=("NestJS CLI")
    fi

    if ! command -v "$PACKAGE_MANAGER" &> /dev/null; then
        missing+=("$PACKAGE_MANAGER")
    fi

    if [[ ${#missing[@]} -gt 0 ]]; then
        print_error "Missing dependencies: ${missing[*]}"
        echo "Install them with:"
        for dep in "${missing[@]}"; do
            case "$dep" in
                "NestJS CLI") echo "  npm i -g @nestjs/cli" ;;
                "pnpm")       echo "  npm i -g pnpm" ;;
                "yarn")       echo "  npm i -g yarn" ;;
            esac
        done
        exit 1
    fi
}

validate_args() {
    local errors=()

    [[ -z "$PROJECT_NAME" ]]    && errors+=("--pn (project name) is required")
    [[ -z "$PACKAGE_MANAGER" ]] && errors+=("--pk (package manager) is required")
    [[ -z "$ARCHITECTURE" ]]    && errors+=("--a (architecture) is required")

    if [[ -n "$PACKAGE_MANAGER" ]]; then
        case "$PACKAGE_MANAGER" in
            pnpm|npm|yarn) ;;
            *) errors+=("Invalid package manager '$PACKAGE_MANAGER'. Use: pnpm | npm | yarn") ;;
        esac
    fi

    if [[ -n "$ARCHITECTURE" ]]; then
        case "$ARCHITECTURE" in
            clean) ;;
            *) errors+=("Invalid architecture '$ARCHITECTURE'. Use: clean") ;;
        esac
    fi

    if [[ ${#errors[@]} -gt 0 ]]; then
        for err in "${errors[@]}"; do
            print_error "$err"
        done
        echo ""
        show_help
        exit 1
    fi
}

create_project() {
    local target_dir
    if [[ -n "$DIRECTORY" ]]; then
        mkdir -p "$DIRECTORY"
        target_dir="$(cd "$DIRECTORY" && pwd)"
    else
        target_dir="$(pwd)"
    fi

    local project_path="$target_dir/$PROJECT_NAME"
    local display_path="${DIRECTORY:+$DIRECTORY/}$PROJECT_NAME"

    if [[ -d "$project_path" ]]; then
        print_error "Directory already exists: $project_path"
        exit 1
    fi

    print_step "Creating NestJS project '$PROJECT_NAME'..."

    local -a nest_args=("new" "$PROJECT_NAME" "--package-manager" "$PACKAGE_MANAGER")
    [[ "$SKIP_GIT" == "true" ]] && nest_args+=("--skip-git")
    [[ "$SKIP_INSTALL" == "true" ]] && nest_args+=("--skip-install")

    (cd "$target_dir" && nest "${nest_args[@]}")

    print_step "Applying $ARCHITECTURE architecture structure..."

    local template="$SCRIPT_DIR/architectures/${ARCHITECTURE}"

    if [[ ! -f "$template" ]]; then
        print_error "Template not found: $template"
        exit 1
    fi

    bash "$template" "$project_path" "$PACKAGE_MANAGER" "$SKIP_INSTALL" "$SCRIPT_DIR"

    echo ""
    print_success "Project '$PROJECT_NAME' is ready!"
    print_info "Architecture : $ARCHITECTURE"
    print_info "Package mgr  : $PACKAGE_MANAGER"
    print_info "Location     : $display_path"
    echo ""
    print_info "Next steps:"
    echo "   cd $display_path"
    [[ "$SKIP_INSTALL" == "true" ]] && echo "   $PACKAGE_MANAGER install"
    echo "   $PACKAGE_MANAGER run start:dev"
    echo ""
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --pn|--project-name)  PROJECT_NAME="$2";    shift 2 ;;
        --pk|--package)       PACKAGE_MANAGER="$2"; shift 2 ;;
        --a|--architecture)   ARCHITECTURE="$2";    shift 2 ;;
        --dir|--directory)    DIRECTORY="$2";       shift 2 ;;
        --skip-install)       SKIP_INSTALL=true;    shift   ;;
        --skip-git)           SKIP_GIT=true;        shift   ;;
        --help)               show_help; exit 0     ;;
        *)
            print_error "Unknown option: $1"
            echo ""
            show_help
            exit 1
            ;;
    esac
done

validate_args
check_dependencies
create_project
